<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ProfileFragment">

    <view
        android:id="@+id/view"
        app:layout_constraintStart_toStartOf="@id/view"
        app:layout_constraintTop_toTopOf="@id/view"
        app:layout_constraintEnd_toEndOf="@id/view"
        android:background="@color/primary"
        android:layout_height="@dimen/_120sdp"
        android:layout_width="match_parent"
        class="androidx.constraintlayout.widget.ConstraintLayout" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_profile_image"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="84dp"
        android:src="@drawable/ic_profile_image_24"
        app:civ_border_color="#FF000000"
        app:civ_border_width="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/view" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Md Rifat Hossain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_profile_image"
        android:layout_marginTop="@dimen/_8sdp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="@dimen/_20ssp"/>

    <TextView
        android:id="@+id/tv_user_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        android:textColor="@color/black"
        android:textSize="@dimen/_14ssp"/>

    <TextView
        android:id="@+id/tv_contact_info"
        android:layout_marginTop="@dimen/_16ssp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_user_type"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/_16ssp"
        android:textSize="@dimen/_20ssp"/>

    <TextView
        android:id="@+id/tv_phone"
        android:layout_marginTop="@dimen/_4ssp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phone: 01275564666"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_contact_info"
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/_14ssp"
        android:textSize="@dimen/_14ssp"/>

    <TextView
        android:id="@+id/tv_email"
        android:layout_marginTop="@dimen/_2ssp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email: mdrifathossain472@gmail.com"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_phone"
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/_14ssp"
        android:textSize="@dimen/_14ssp"/>

    <TextView
        android:id="@+id/tv_nid"
        android:layout_marginTop="@dimen/_2ssp"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NID: 2465464624"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_email"
        android:textColor="@color/black"
        android:layout_marginBottom="@dimen/_14ssp"
        android:textSize="@dimen/_14ssp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_edit_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:textAllCaps="false"
        android:layout_marginBottom="@dimen/_16sdp"
        android:background="@drawable/btn_create_account"
        android:text="Edit Profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_16ssp" />



</androidx.constraintlayout.widget.ConstraintLayout>