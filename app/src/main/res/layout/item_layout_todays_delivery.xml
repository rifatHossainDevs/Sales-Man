<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginBottom="@dimen/_8sdp"
    android:backgroundTint="@color/card_bg"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="@dimen/_2sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_10sdp">

        <TextView
            android:id="@+id/tv_invoice_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:text="Invoice: INV/001"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintEnd_toStartOf="@id/tv_total"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_payment_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/poppins"
            android:text="Date: 06-08-2025"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toStartOf="@id/btnViewInvoice"
            app:layout_constraintStart_toStartOf="@id/tv_invoice_number"
            app:layout_constraintTop_toBottomOf="@id/tv_invoice_number" />

        <TextView
            android:id="@+id/tv_shipment_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:text="Mirpur-12"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toStartOf="@id/btnViewInvoice"
            app:layout_constraintStart_toStartOf="@id/tv_payment_status"
            app:layout_constraintTop_toBottomOf="@id/tv_payment_status" />

        <TextView
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="৳0.00"
            android:textColor="@color/primary"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewInvoice"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:backgroundTint="@color/secondary_soft"
            android:fontFamily="@font/poppins_medium"
            android:paddingHorizontal="10dp"
            android:text="View Invoice"
            android:textColor="@color/secondary"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
