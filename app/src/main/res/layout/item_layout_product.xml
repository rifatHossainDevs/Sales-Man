<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginBottom="@dimen/_8sdp"
    android:backgroundTint="@color/card_bg"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="@dimen/_2sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_10sdp">

        <ImageView
            android:id="@+id/iv_product"
            android:layout_width="@dimen/_52sdp"
            android:layout_height="@dimen/_52sdp"
            android:background="@drawable/bg_customer_item"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/product"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:text="LED TV 32''"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toStartOf="@id/layout_increment_decrement"
            app:layout_constraintStart_toEndOf="@id/iv_product"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_brand_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:text="Walton"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toEndOf="@id/tv_product_name"
            app:layout_constraintStart_toStartOf="@id/tv_product_name"
            app:layout_constraintTop_toBottomOf="@id/tv_product_name" />

        <TextView
            android:id="@+id/tv_stock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:maxLines="1"
            android:text="Stock: 100 pcs"
            android:textColor="@color/success_green"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintEnd_toEndOf="@id/tv_product_name"
            app:layout_constraintStart_toStartOf="@id/tv_brand_name"
            app:layout_constraintTop_toBottomOf="@id/tv_brand_name" />

        <TextView
            android:id="@+id/tv_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Price: ৳100"
            android:textColor="@color/secondary"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toStartOf="@id/tv_stock"
            app:layout_constraintTop_toBottomOf="@id/tv_stock" />

        <LinearLayout
            android:id="@+id/layout_increment_decrement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/tv_subtotal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_decrement"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/shape_increment_decrement"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_minus_24" />

            <EditText
                android:id="@+id/et_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_4sdp"
                android:background="@drawable/shape_increment_decrement"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:hint="0"
                android:inputType="numberDecimal"
                android:maxWidth="@dimen/_50sdp"
                android:minWidth="@dimen/_34sdp"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_2sdp"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="@dimen/_13ssp" />

            <ImageView
                android:id="@+id/iv_increment"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/shape_increment_decrement"
                android:padding="@dimen/_4sdp"
                android:src="@drawable/ic_add_black_24" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_subtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Subtotal: ৳0.00"
            android:textColor="@color/primary"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_increment_decrement" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
