<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Keep consistent clean light theme for B2B field usability -->
    <style name="Base.Theme.DealershipManagement" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@color/secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="Theme.DealershipManagement.MainActivity" parent="Base.Theme.DealershipManagement">
        <item name="android:statusBarColor">@color/secondary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
