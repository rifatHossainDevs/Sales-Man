<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.wevx.dealershipmanagement.presentation.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_addCustomerFragment"
            app:destination="@id/addCustomerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_storeOwnerDetailsFragment"
            app:destination="@id/storeOwnerDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/productsFragment"
        android:name="com.wevx.dealershipmanagement.presentation.product.ProductsFragment"
        android:label="fragment_products"
        tools:layout="@layout/fragment_products">

        <argument
            android:name="id"
            app:argType="string" />

        <action
            android:id="@+id/action_productsFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.wevx.dealershipmanagement.presentation.payment.PaymentFragment"
        android:label="fragment_payment"
        tools:layout="@layout/fragment_payment">

        <argument
            android:name="id"
            app:argType="string" />

        <action
            android:id="@+id/action_paymentFragment_to_receiptFragment"
            app:destination="@id/receiptFragment" />
    </fragment>
    <fragment
        android:id="@+id/receiptFragment"
        android:name="com.wevx.dealershipmanagement.presentation.receipt.ReceiptFragment"
        android:label="fragment_receipt"
        tools:layout="@layout/fragment_receipt">
        <argument
            android:name="id"
            app:argType="string" />

        <action
            android:id="@+id/action_receiptFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/addCustomerFragment"
        android:name="com.wevx.dealershipmanagement.presentation.addCustomer.AddCustomerFragment"
        android:label="fragment_add_customer"
        tools:layout="@layout/fragment_add_customer">
        <action
            android:id="@+id/action_addCustomerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.wevx.dealershipmanagement.presentation.auth.changePassword.ChangePasswordFragment"
        android:label="fragment_change_password"
        tools:layout="@layout/fragment_change_password" />
    <fragment
        android:id="@+id/storeOwnerDetailsFragment"
        android:name="com.wevx.dealershipmanagement.presentation.storeOwnerDetails.StoreOwnerDetailsFragment"
        android:label="fragment_store_owner_details"
        tools:layout="@layout/fragment_store_owner_details">

        <argument
            android:name="id"
            app:argType="string" />

        <action
            android:id="@+id/action_storeOwnerDetailsFragment_to_productsFragment"
            app:destination="@id/productsFragment" />
    </fragment>
    <fragment
        android:id="@+id/stockAvailabilityFragment"
        android:name="com.wevx.dealershipmanagement.presentation.stockAvailability.StockAvailabilityFragment"
        android:label="fragment_stock_availability"
        tools:layout="@layout/fragment_stock_availability" />
    <fragment
        android:id="@+id/todaysDeliveryFragment"
        android:name="com.wevx.dealershipmanagement.presentation.todaysDelivery.TodaysDeliveryFragment"
        android:label="fragment_todays_delivery"
        tools:layout="@layout/fragment_todays_delivery" />
    <fragment
        android:id="@+id/paymentCollectionFragment"
        android:name="com.wevx.dealershipmanagement.PaymentCollectionFragment"
        android:label="fragment_payment_collection"
        tools:layout="@layout/fragment_payment_collection" />
    <fragment
        android:id="@+id/paymentHistoryFragment"
        android:name="com.wevx.dealershipmanagement.PaymentHistoryFragment"
        android:label="fragment_payment_history"
        tools:layout="@layout/fragment_payment_history" />
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.wevx.dealershipmanagement.presentation.auth.updateProfile.UpdateProfileFragment"
        android:label="fragment_edit_profile"
        tools:layout="@layout/fragment_edit_profile">
        <action
            android:id="@+id/action_editProfileFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>